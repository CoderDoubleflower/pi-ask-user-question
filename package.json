{
  "name": "pi-ask-user-question",
  "version": "0.1.0",
  "description": "Claude Code-style structured question tool for Pi, with optional pi-open-tui integration.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoderDoubleflower/pi-open-tui.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "questionnaire",
    "tui"
  ],
  "files": [
    "extensions/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
